rules_version = '2';
// Project Butterfly — Firestore security rules
// Anyone signed in can READ the leaderboard; only YOU can write your own record.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username','best','bestDist','maxLevel','totalOrbs','runs','colors','run','settings','updatedAt','serverTime'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1 && request.resource.data.username.size() <= 16
        && request.resource.data.best is number && request.resource.data.best >= 0 && request.resource.data.best < 100000000;
      allow delete: if false;
    }
  }
}
